<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="20sp"
    android:background="@color/background_color"
    tools:context=".ui.profile.LoginRegisterFragment">

    <ImageView
        android:layout_width="320dp"
        android:layout_height="300dp"
        android:src="@drawable/ic_bg_login_register" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="10dp"
        android:text="Vui lòng đăng nhập để có trải nghệm tôt nhất nhé!"
        android:textColor="#314899"
        android:textSize="25sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="Khám phá hàng ngàn ưu đãi đặc quyền được thiết kế dành riêng cho bạn. Hành trình mua sắm bắt đầu từ đây"
        android:textColor="@color/black"
        android:textSize="15sp" />


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginVertical="10sp">


        <Button
            style="@style/Widget.Material3.Button.Icon"
            android:id="@+id/sign_in_btn"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:text="Đăng nhặp"
            app:icon="@drawable/ic_login"
            app:shapeAppearance="@style/RoundedSquare.30Percent"
            android:backgroundTint="@color/blue_button"/>

        <Button
            style="@style/Widget.Material3.Button.Icon"
            android:id="@+id/register_btn"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Đăng ký"
            app:icon="@drawable/ic_register"
            app:shapeAppearance="@style/RoundedSquare.30Percent"
            android:backgroundTint="@color/orange_button"/>


    </LinearLayout>

</LinearLayout>