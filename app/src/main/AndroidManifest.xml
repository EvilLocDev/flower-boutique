<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <queries>
        <package android:name="vn.com.vng.zalopay" />
        <package android:name="vn.com.vng.zalopay.sandbox" />
        <package android:name="com.zing.zalo" />
    </queries>

    <application
        android:name=".BoutiqueApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlowerBoutique"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".ui.admin.dashboard.AdminDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.AdminActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.categories.AdminCategoryManagementActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.categories.AdminCategoryDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.products.AdminProductDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".ui.admin.users.AdminUserManagementActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.products.AdminProductManagementActivity"
            android:exported="false" />
        <activity
            android:name=".ui.orders.CustomerOrdersActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.orders.AdminOrderDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.orders.OrderManagementActivity"
            android:exported="false" />
        <activity
            android:name=".ui.main_home.ProductSearchActivity"
            android:exported="false" />
        <activity
            android:name=".ui.main_home.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.profile.ModifyProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.categorydetail.CategoryDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.cart.CartActivity"
            android:exported="false" />
        <activity
            android:name=".ui.makeorder.MakeOrderActivity"
            android:exported="false" />
        <activity
            android:name=".ui.authen.SignUpActivity"
            android:exported="false" />
        <activity
            android:name=".ui.productdetail.ProductDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.authen.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.payment.PaymentResultActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="vnpay_return"
                    android:scheme="flowerboutique" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.payment.VNPayPaymentActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="app"
                    android:scheme="flowerstore" />
            </intent-filter>
        </activity>
    </application>

</manifest>